@prefix : <https://marianomosquera.github.io/accountability#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

### ============================================
### ACCOUNTABILITY
### ============================================

:Accountability a skos:Concept ;
    skos:prefLabel "Accountability"@es ;
    skos:altLabel "Rendición de cuentas"@es ;
    skos:narrower :Transparencia ,
                  :Control ,
                  :Sancion ,
                  :Problemas ,
                  :Actores .


### ============================================
### CONTROL
### ============================================

:Control a skos:Concept ;
    skos:prefLabel "Control"@es ;
    skos:broader :Accountability ;
    skos:narrower :TipoControl ,
                  :Periodicidad ,
                  :Denuncia .

:TipoControl a skos:Concept ;
    skos:prefLabel "Tipo"@es ;
    skos:broader :Control ;
    skos:narrower :Auditoria ,
                  :Evaluacion ,
                  :MejoraContinua ,
                  :Supervision ,
                  :Fiscalizacion ,
                  :Vigilancia .

:Auditoria a skos:Concept ;
    skos:prefLabel "Auditoría"@es ;
    skos:broader :TipoControl .

:Evaluacion a skos:Concept ;
    skos:prefLabel "Evaluación"@es ;
    skos:broader :TipoControl .

:MejoraContinua a skos:Concept ;
    skos:prefLabel "Mejora continua"@es ;
    skos:broader :TipoControl .

:Supervision a skos:Concept ;
    skos:prefLabel "Supervisión"@es ;
    skos:broader :TipoControl .

:Fiscalizacion a skos:Concept ;
    skos:prefLabel "Fiscalización"@es ;
    skos:broader :TipoControl .

:Vigilancia a skos:Concept ;
    skos:prefLabel "Vigilancia"@es ;
    skos:broader :TipoControl .

:Periodicidad a skos:Concept ;
    skos:prefLabel "Periodicidad"@es ;
    skos:broader :Control .


### ============================================
### DENUNCIA
### Ahora depende de Control
### ============================================

:Denuncia a skos:Concept ;
    skos:prefLabel "Denuncia"@es ;
    skos:broader :Control ;
    skos:narrower :ProteccionDenunciantes .

:ProteccionDenunciantes a skos:Concept ;
    skos:prefLabel "Protección de denunciantes"@es ;
    skos:broader :Denuncia .


### ============================================
### SANCIÓN
### ============================================

:Sancion a skos:Concept ;
    skos:prefLabel "Sanción"@es ;
    skos:broader :Accountability ;
    skos:narrower :Memoria .


### ============================================
### MEMORIA
### Ahora depende de Sanción
### ============================================

:Memoria a skos:Concept ;
    skos:prefLabel "Memoria"@es ;
    skos:broader :Sancion ;
    skos:narrower :ListasNegras .

:ListasNegras a skos:Concept ;
    skos:prefLabel "Listas negras"@es ;
    skos:altLabel "Registro de infractores"@es ;
    skos:broader :Memoria .


### ============================================
### TRANSPARENCIA
### ============================================

:Transparencia a skos:Concept ;
    skos:prefLabel "Transparencia"@es ;
    skos:broader :Accountability ;
    skos:narrower :TipoTransparencia ,
                  :Justificacion ,
                  :Restricciones .

:TipoTransparencia a skos:Concept ;
    skos:prefLabel "Tipo"@es ;
    skos:broader :Transparencia ;
    skos:narrower :Divulgacion ,
                  :Apertura ,
                  :Visibilidad ,
                  :Publicidad ,
                  :Reporting ,
                  :DatosAbiertos .

:Divulgacion a skos:Concept ;
    skos:prefLabel "Divulgación"@es ;
    skos:broader :TipoTransparencia .

:Apertura a skos:Concept ;
    skos:prefLabel "Apertura"@es ;
    skos:broader :TipoTransparencia .

:Visibilidad a skos:Concept ;
    skos:prefLabel "Visibilidad"@es ;
    skos:broader :TipoTransparencia .

:Publicidad a skos:Concept ;
    skos:prefLabel "Publicidad"@es ;
    skos:broader :TipoTransparencia .

:Reporting a skos:Concept ;
    skos:prefLabel "Reporting"@es ;
    skos:broader :TipoTransparencia .

:DatosAbiertos a skos:Concept ;
    skos:prefLabel "Datos abiertos"@es ;
    skos:broader :TipoTransparencia .


### ============================================
### JUSTIFICACIÓN
### ============================================

:Justificacion a skos:Concept ;
    skos:prefLabel "Justificación"@es ;
    skos:broader :Transparencia ;
    skos:narrower :Answerability ,
                  :Explicabilidad ,
                  :AccesoInformacion .

:Answerability a skos:Concept ;
    skos:prefLabel "Answerability"@es ;
    skos:broader :Justificacion .

:Explicabilidad a skos:Concept ;
    skos:prefLabel "Explicabilidad"@es ;
    skos:broader :Justificacion .

:AccesoInformacion a skos:Concept ;
    skos:prefLabel "Acceso a información"@es ;
    skos:broader :Justificacion .

:Restricciones a skos:Concept ;
    skos:prefLabel "Restricciones"@es ;
    skos:broader :Transparencia .


### ============================================
### PROBLEMAS
### ============================================

:Problemas a skos:Concept ;
    skos:prefLabel "Problemas"@es ;
    skos:broader :Accountability ;
    skos:narrower :Sobreinformacion .

:Sobreinformacion a skos:Concept ;
    skos:prefLabel "Sobreinformación"@es ;
    skos:broader :Problemas .


### ============================================
### ACTORES
### ============================================

:Actores a skos:Concept ;
    skos:prefLabel "Actores"@es ;
    skos:broader :Accountability ;
    skos:narrower :Expertos ,
                  :Afectados .

:Expertos a skos:Concept ;
    skos:prefLabel "Expertos"@es ;
    skos:broader :Actores ;
    skos:narrower :Prensa ,
                  :ONG ,
                  :Watchdog ,
                  :AccionColectiva .

:Afectados a skos:Concept ;
    skos:prefLabel "Afectados"@es ;
    skos:broader :Actores .

:Prensa a skos:Concept ;
    skos:prefLabel "Prensa"@es ;
    skos:broader :Expertos .

:ONG a skos:Concept ;
    skos:prefLabel "ONG"@es ;
    skos:broader :Expertos .

:Watchdog a skos:Concept ;
    skos:prefLabel "Watchdog"@es ;
    skos:broader :Expertos .

:AccionColectiva a skos:Concept ;
    skos:prefLabel "Acción colectiva"@es ;
    skos:broader :Expertos .
