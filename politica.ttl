@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix pol: <https://marianomosquera.github.io/politica/> .

pol:Politica
    a skos:Concept ;
    skos:prefLabel "Política"@es .

# =========================================
# CONCEPTOS PRIMARIOS
# =========================================

pol:Geopolitica
    a skos:Concept ;
    skos:prefLabel "Geopolítica"@es ;
    skos:broader pol:Politica ;
    skos:related pol:PoliticaInternacional .

pol:PoliticaInternacional
    a skos:Concept ;
    skos:prefLabel "Política internacional"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Geopolitica ;
    skos:related pol:Globalizacion .

pol:Democracia
    a skos:Concept ;
    skos:prefLabel "Democracia"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Elecciones ;
    skos:related pol:Ciudadania .

pol:Ideologia
    a skos:Concept ;
    skos:prefLabel "Ideología"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Polarizacion .

pol:Elecciones
    a skos:Concept ;
    skos:prefLabel "Elecciones"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Democracia .

pol:Crisis
    a skos:Concept ;
    skos:prefLabel "Crisis"@es ;
    skos:broader pol:Politica .

pol:Globalizacion
    a skos:Concept ;
    skos:prefLabel "Globalización"@es ;
    skos:broader pol:Politica ;
    skos:related pol:PoliticaInternacional .

pol:Ciudadania
    a skos:Concept ;
    skos:prefLabel "Ciudadanía"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Democracia ;
    skos:related pol:LibertadExpresion .

pol:LibertadExpresion
    a skos:Concept ;
    skos:prefLabel "Libertad de expresión"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Ciudadania ;
    skos:related pol:Desinformacion .

pol:Polarizacion
    a skos:Concept ;
    skos:prefLabel "Polarización"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Ideologia ;
    skos:related pol:Desinformacion .

pol:Desinformacion
    a skos:Concept ;
    skos:prefLabel "Desinformación"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Polarizacion ;
    skos:related pol:LibertadExpresion .

pol:AsuntosDeGrupos
    a skos:Concept ;
    skos:prefLabel "Asuntos de Grupos"@es ;
    skos:broader pol:Politica ;
    skos:related pol:Ciudadania .

# =========================================
# CONCEPTOS SECUNDARIOS
# =========================================

pol:Autoritarismo
    a skos:Concept ;
    skos:prefLabel "Autoritarismo"@es ;
    skos:broader pol:Democracia .

pol:Populismo
    a skos:Concept ;
    skos:prefLabel "Populismo"@es ;
    skos:broader pol:Democracia .

pol:PartidosPoliticos
    a skos:Concept ;
    skos:prefLabel "Partidos políticos"@es ;
    skos:broader pol:Elecciones ;
    skos:related pol:Ideologia .

pol:Antiglobalizacion
    a skos:Concept ;
    skos:prefLabel "Antiglobalización"@es ;
    skos:broader pol:Globalizacion .

pol:Genero
    a skos:Concept ;
    skos:prefLabel "Género"@es ;
    skos:broader pol:AsuntosDeGrupos .

pol:Migracion
    a skos:Concept ;
    skos:prefLabel "Migración"@es ;
    skos:broader pol:AsuntosDeGrupos .

pol:GruposOriginarios
    a skos:Concept ;
    skos:prefLabel "Grupos originarios"@es ;
    skos:broader pol:AsuntosDeGrupos .

pol:LGBT
    a skos:Concept ;
    skos:prefLabel "LGBT"@es ;
    skos:broader pol:AsuntosDeGrupos .
