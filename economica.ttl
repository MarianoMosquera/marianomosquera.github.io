@prefix eco: <https://marianomosquera.github.io/economica/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# =========================================
# CONCEPTO PRINCIPAL
# =========================================

eco:Economica
    a skos:Concept ;
    skos:prefLabel "Económica"@es ;
    skos:altLabel "Economía"@es .


# =========================================
# TEMAS
# =========================================

eco:Temas
    a skos:Concept ;
    skos:prefLabel "Temas"@es ;
    skos:broader eco:Economica .


# =========================================
# MERCADO
# =========================================

eco:Mercado
    a skos:Concept ;
    skos:prefLabel "Mercado"@es ;
    skos:broader eco:Temas .

eco:Empresa
    a skos:Concept ;
    skos:prefLabel "Empresa"@es ;
    skos:broader eco:Mercado .

eco:Crecimiento
    a skos:Concept ;
    skos:prefLabel "Crecimiento"@es ;
    skos:broader eco:Mercado .

eco:Riqueza
    a skos:Concept ;
    skos:prefLabel "Riqueza"@es ;
    skos:broader eco:Crecimiento .


# =========================================
# POLÍTICA ECONÓMICA
# =========================================

eco:PoliticaEconomica
    a skos:Concept ;
    skos:prefLabel "Política económica"@es ;
    skos:broader eco:Temas .

eco:Fiscal
    a skos:Concept ;
    skos:prefLabel "Fiscal"@es ;
    skos:broader eco:PoliticaEconomica .

